# CardIntel — Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================================
# Database — Neon PostgreSQL
# ============================================================
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cardintel?sslmode=require"

# ============================================================
# Authentication — Auth.js
# ============================================================
AUTH_SECRET="" # Run `npx auth secret` to generate
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin allowlist (comma-separated emails)
ADMIN_ALLOWLIST=""

# ============================================================
# Object Storage — S3-compatible (Cloudflare R2 or AWS S3)
# ============================================================
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="cardintel-sources"
S3_REGION="auto"

# ============================================================
# AI Model Router
# ============================================================
GOOGLE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ============================================================
# Trigger.dev — Background Jobs
# ============================================================
TRIGGER_SECRET_KEY=""
TRIGGER_API_URL=""

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_BRAND_NAME="CardIntel"
NEXT_PUBLIC_BRAND_TAGLINE="India's Credit Card Intelligence Platform"
NEXT_PUBLIC_DOMAIN="cardintel.in"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ============================================================
# Monitoring (Optional)
# ============================================================
SENTRY_DSN=""
